
---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";

import IconArrowRight from "@/assets/icons/IconArrowRight.svg";

import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import AuthorSidebar from "@/components/AuthorSidebar.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";

import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import config from "@/config";

// ========================================
// IDIOMA Y TRADUCCIONES
// ========================================

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

// ========================================
// PUBLICACIONES
// ========================================

// Obtener las publicaciones de Astro Content Collections.
const posts = await getCollection("posts");

// Ordenar y seleccionar las cinco más recientes.
// También incluye las publicaciones marcadas como featured.
const recentPosts = getSortedPosts(posts).slice(0, 5);

// Ruta de inicio correspondiente al idioma.
const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <Header />

  <div class="home-layout app-layout">
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="my-1 min-w-0"
  >
    <!-- ======================================== -->
    <!-- PRESENTACIÓN DEL BLOG -->
    <!-- ======================================== -->

    <section
      id="hero"
      class="border-border border-b pt-6 pb-8 sm:pt-8 sm:pb-10"
    >
      <!-- TÍTULO Y TERMINAL -->
      <div class="hero-reveal hero-reveal-1 mt-2">

        <!-- TÍTULO PRINCIPAL -->
        <h1
          class="max-w-5xl text-3xl font-bold leading-[1.15] tracking-tight sm:text-4xl lg:text-5xl"
        >
          {t.home.titleStart}{" "}

          <span class="hero-glow text-accent">
            {t.home.titleEnd}
          </span>
        </h1>

        <!-- TERMINAL CON EFECTO TYPING -->
        <div
          class="terminal-line text-accent mt-5 text-sm font-semibold tracking-normal uppercase sm:text-base sm:tracking-wide"
        >
          <span
            class="terminal-prompt"
            aria-hidden="true"
          >&gt;&nbsp;</span>

          <span
            id="hero-specialty"
            class="hero-specialty"
            data-specialties={JSON.stringify(t.home.specialties)}
            aria-label={t.home.specialties.join(", ")}
          >{t.home.specialties[0]}</span>

          <span
            class="terminal-cursor"
            aria-hidden="true"
          ></span>
        </div>
      </div>

      <!-- DESCRIPCIÓN -->
      <p
        class="hero-reveal hero-reveal-2 text-muted-foreground mt-6 max-w-3xl text-base leading-[1.85] sm:text-lg"
      >
        {t.home.description}
      </p>
    </section>

    <!-- ======================================== -->
    <!-- CINCO INVESTIGACIONES MÁS RECIENTES -->
    <!-- ======================================== -->

    {
      recentPosts.length > 0 && (
        <section
          id="recent-posts"
          class="home-section-reveal pt-8 pb-7 sm:pt-10"
        >
          <h2
            class="text-2xl font-semibold tracking-wide"
          >
            {t.home.recentPosts}
          </h2>

          <!-- PUBLICACIONES -->
          <ul>
            {recentPosts.map(post => (
              <Card
                variant="h3"
                {...post}
              />
            ))}
          </ul>
        </section>
      )
    }

    <!-- ======================================== -->
    <!-- ENLACE A TODAS LAS INVESTIGACIONES -->
    <!-- ======================================== -->

    <div
      class="my-6 text-center"
    >
      <LinkButton
        href={getRelativeLocaleUrl(locale, "posts")}
      >
        {t.home.allPosts}

        <IconArrowRight
          class="inline-block rtl:-rotate-180"
        />
      </LinkButton>
    </div>

  </main>
  <AuthorSidebar postCount={getSortedPosts(posts).length} />
  </div>

  <Footer />
</Layout>

<!-- ======================================== -->
<!-- ESTILOS Y ANIMACIONES -->
<!-- ======================================== -->

<style>
  .home-layout { display: grid; gap: 2rem; }
  @media (min-width: 64rem) {
    .home-layout { grid-template-columns: 13.5rem minmax(0, 1fr); gap: 2.5rem; margin-top: 2rem; }
    .home-layout :global(.author-sidebar) { grid-column: 1; grid-row: 1; }
    .home-layout main { grid-column: 2; grid-row: 1; }
  }
  /*
   * 1. APARICIÓN PROGRESIVA
   *
   * Solo se anima la opacidad para evitar
   * saltos de posición en el contenido.
   */

  @keyframes home-fade-in {
    from {
      opacity: 0;
    }

    to {
      opacity: 1;
    }
  }

  .hero-reveal {
    animation: home-fade-in 560ms ease-out both;
  }

  .hero-reveal-1 {
    animation-delay: 40ms;
  }

  .hero-reveal-2 {
    animation-delay: 140ms;
  }

  /*
   * 2. APARICIÓN DE INVESTIGACIONES
   */

  .home-section-reveal {
    animation: home-fade-in 650ms ease-out 380ms both;
  }

  /*
   * 3. TERMINAL
   *
   * El cursor sigue el texto durante
   * la escritura y el borrado.
   */

  .terminal-line {
    display: flex;
    align-items: center;

    min-height: 1.7em;
    max-width: 100%;

    line-height: 1.6;
    white-space: nowrap;
  }

  .terminal-prompt {
    flex-shrink: 0;
    user-select: none;
  }

  .hero-specialty {
    display: inline-block;
    min-width: 0;
  }

  /*
   * 4. CURSOR PARPADEANTE
   */

  .terminal-cursor {
    display: inline-block;

    width: 2px;
    height: 1.1em;

    margin-left: 4px;
    flex-shrink: 0;

    background-color: var(--accent);

    animation: terminal-blink 850ms steps(1) infinite;
  }

  @keyframes terminal-blink {
    0%,
    49% {
      opacity: 1;
    }

    50%,
    100% {
      opacity: 0;
    }
  }

  /*
   * 5. RESPLANDOR DEL TÍTULO
   *
   * El efecto se aplica a la clase
   * hero-glow sin desenfocar las letras.
   */

  @keyframes knowledge-glow {
    0%,
    100% {
      text-shadow: 0 0 0 transparent;
    }

    50% {
      text-shadow:
        0 0 8px
          color-mix(
            in srgb,
            var(--accent) 40%,
            transparent
          ),
        0 0 20px
          color-mix(
            in srgb,
            var(--accent) 15%,
            transparent
          );
    }
  }

  .hero-glow {
    animation: knowledge-glow 5s ease-in-out infinite;
  }

  /*
   * 6. ACCESIBILIDAD
   */

  @media (prefers-reduced-motion: reduce) {
    .hero-reveal,
    .home-section-reveal,
    .hero-glow,
    .terminal-cursor {
      animation: none !important;
    }
  }
</style>

<!-- ======================================== -->
<!-- JAVASCRIPT: EFECTO TYPING -->
<!-- ======================================== -->

<script>
  /*
   * Efecto:
   *
   * Mostrar texto
   *     ↓
   * Pausar
   *     ↓
   * Borrar carácter por carácter
   *     ↓
   * Escribir siguiente especialidad
   *     ↓
   * Repetir
   *
   * Compatible con Astro ClientRouter.
   */

  let typingTimer: number | undefined;

  // ======================================
  // LIMPIAR TEMPORIZADORES
  // ======================================

  function stopTyping() {
    if (typingTimer !== undefined) {
      window.clearTimeout(typingTimer);
      typingTimer = undefined;
    }
  }

  // ======================================
  // INICIALIZAR PORTADA
  // ======================================

  function initializeHome() {
    stopTyping();

    const main = document.querySelector<HTMLElement>(
      '#main-content[data-layout="index"]'
    );

    if (!main) return;

    // ------------------------------------
    // Mantener navegación de AstroPaper
    // ------------------------------------

    const baseRoot = import.meta.env.BASE_URL.replace(
      /\/?$/,
      "/"
    );

    sessionStorage.setItem(
      "backUrl",
      main.dataset.homePath ?? baseRoot
    );

    // ------------------------------------
    // Obtener etiqueta de terminal
    // ------------------------------------

    const label = main.querySelector<HTMLElement>(
      "#hero-specialty"
    );

    if (!label) return;

    // ------------------------------------
    // Obtener traducciones
    // ------------------------------------

    let specialties: string[];

    try {
      const parsed: unknown = JSON.parse(
        label.dataset.specialties ?? "[]"
      );

      if (
        !Array.isArray(parsed) ||
        !parsed.every(
          item => typeof item === "string"
        )
      ) {
        return;
      }

      specialties = parsed.filter(Boolean);
    } catch {
      return;
    }

    if (specialties.length === 0) return;

    // ------------------------------------
    // Accesibilidad
    // ------------------------------------

    const reducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)"
    );

    label.textContent = specialties[0];

    if (
      reducedMotion.matches ||
      specialties.length < 2
    ) {
      return;
    }

    // ------------------------------------
    // Configuración de velocidad
    // ------------------------------------

    const TYPE_SPEED = 85;
    const DELETE_SPEED = 40;

    const PAUSE_AFTER_TYPING = 1600;
    const PAUSE_AFTER_DELETING = 80;

    // ------------------------------------
    // Estado inicial
    // ------------------------------------

    let wordIndex = 0;

    const characters = specialties.map(
      text => Array.from(text)
    );

    let charIndex = characters[0].length;
    let deleting = true;

    // ------------------------------------
    // Animación
    // ------------------------------------

    function tick() {
      if (!label?.isConnected) {
        stopTyping();
        return;
      }

      // Evitar trabajo cuando la pestaña
      // no está visible.
      if (document.hidden) {
        typingTimer = window.setTimeout(
          tick,
          500
        );

        return;
      }

      const current = characters[wordIndex];

      let delay: number;

      if (deleting) {
        // BORRAR
        charIndex = Math.max(
          0,
          charIndex - 1
        );

        label.textContent = current
          .slice(0, charIndex)
          .join("");

        delay = DELETE_SPEED;

        if (charIndex === 0) {
          deleting = false;

          wordIndex =
            (wordIndex + 1) % characters.length;

          delay = PAUSE_AFTER_DELETING;
        }
      } else {
        // ESCRIBIR
        const next = characters[wordIndex];

        charIndex = Math.min(
          next.length,
          charIndex + 1
        );

        label.textContent = next
          .slice(0, charIndex)
          .join("");

        delay = TYPE_SPEED;

        if (charIndex === next.length) {
          deleting = true;

          delay = PAUSE_AFTER_TYPING;
        }
      }

      typingTimer = window.setTimeout(
        tick,
        delay
      );
    }

    // Primera pausa con el texto completo.
    typingTimer = window.setTimeout(
      tick,
      PAUSE_AFTER_TYPING
    );
  }

  // ======================================
  // ASTRO CLIENT ROUTER
  // ======================================

  document.addEventListener(
    "astro:page-load",
    initializeHome
  );

  document.addEventListener(
    "astro:before-swap",
    stopTyping
  );
</script>

