---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import { useTranslations } from "@/i18n";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
const { contact } = t.pages;
const socials = config.socials.filter(({ name }) => name !== "gmail");
---

<Layout
  title={`${contact.title} | ${config.site.title}`}
  description={contact.description}
>
  <Header />
  <Breadcrumb />
  <Main
    pageTitle={contact.title}
    pageDesc={contact.description}
    class="contact-page"
  >
    <div class="contact-content">
      <section aria-labelledby="profile-title">
        <h2 id="profile-title">{contact.profileTitle}</h2>
        <p>{contact.profile}</p>
      </section>

      <section aria-labelledby="experience-title">
        <h2 id="experience-title">{contact.experienceTitle}</h2>
        <p>{contact.experience}</p>
      </section>

      <section aria-labelledby="highlights-title">
        <h2 id="highlights-title">{contact.highlightsTitle}</h2>
        <ul>{contact.highlights.map(item => <li>{item}</li>)}</ul>
      </section>

      <section aria-labelledby="contact-title" class="contact-details">
        <h2 id="contact-title">{contact.contactTitle}</h2>
        <p>{contact.location}</p>
        <ul>
          <li>
            <span>{contact.email}</span><a
              href="mailto:robertoramospereiro0412@gmail.com"
              >robertoramospereiro0412@gmail.com</a>
          </li>
          <li>
            <span>{contact.phone}</span><a href="tel:+5358978698"
              >+53 58978698</a>
          </li>
          {
            socials.map(({ name, url }) => (
              <li>
                <>
                  <span>{name.charAt(0).toUpperCase() + name.slice(1)}</span>
                  <a href={url} target="_blank" rel="noopener noreferrer">
                    {url.replace(/^https?:\/\//, "")}
                  </a>
                </>
              </li>
            ))
          }
        </ul>
      </section>
    </div>
  </Main>
  <Footer />
</Layout>

<style>
  .contact-content {
    display: grid;
    gap: 2rem;
    max-width: 48rem;
    padding-bottom: 3rem;
  }
  section {
    border-top: 1px solid var(--color-border);
    padding-top: 1.25rem;
  }
  h2 {
    margin-bottom: 0.75rem;
    color: var(--color-accent);
    font-size: 1.2rem;
    font-weight: 700;
  }
  p,
  li {
    line-height: 1.8;
  }
  section > ul {
    padding-left: 1.25rem;
    list-style: disc;
  }
  section > ul li + li {
    margin-top: 0.4rem;
  }
  .contact-details > ul {
    padding: 0;
    list-style: none;
    margin-top: 1rem;
  }
  .contact-details li {
    display: grid;
    gap: 0.15rem;
    overflow-wrap: anywhere;
  }
  .contact-details li span {
    color: var(--color-muted-foreground);
    font-size: 0.85rem;
  }
  a {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  @media (min-width: 40rem) {
    .contact-details li {
      grid-template-columns: 8rem minmax(0, 1fr);
      gap: 1rem;
    }
  }
</style>
