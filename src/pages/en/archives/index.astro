---
import { getRelativeLocaleUrl } from "astro:i18n";
import Page from "../../archives/index.astro";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;

if (!config.features.showArchives) {
  return Astro.rewrite(getRelativeLocaleUrl(locale, "404"));
}
---

<Page />
