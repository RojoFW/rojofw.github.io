
---
import { getRelativeLocaleUrl } from "astro:i18n";

import IconUnderline from "@/assets/icons/IconUnderline.svg";
import IconMenuDeep from "@/assets/icons/IconMenuDeep.svg";
import IconArchive from "@/assets/icons/IconArchive.svg";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import IconSearch from "@/assets/icons/IconSearch.svg";
import IconMoon from "@/assets/icons/IconMoon.svg";
import IconX from "@/assets/icons/IconX.svg";

import LinkButton from "./LinkButton.astro";
import LanguageSwitcher from "./LanguageSwitcher.astro";

import { stripBase, stripLocale } from "@/utils/withBase";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { site, features } = config;

const locale = Astro.currentLocale ?? site.lang;
const t = useTranslations(locale);

const relativePath = stripBase(Astro.url.pathname);

const pathWithoutTrailingSlash =
  relativePath.endsWith("/") && relativePath !== "/"
    ? relativePath.slice(0, -1)
    : relativePath;

const currentPath = stripLocale(
  pathWithoutTrailingSlash,
  locale
);

const isActive = (path: string) => {
  const current = currentPath.split("/").filter(Boolean);
  const expected = path.split("/").filter(Boolean);

  return (
    currentPath === path ||
    (expected.length > 0 && current[0] === expected[0])
  );
};
---

<!-- Accesibilidad -->
<a
  id="skip-to-content"
  href="#main-content"
  class="bg-background text-accent absolute inset-s-16 -top-full z-50 px-3 py-2 backdrop-blur-lg transition-all focus:top-4"
>
  {t.a11y.skipToContent}
</a>

<header class="app-layout">
  <div class="border-border border-b py-3 sm:py-5">

    <!-- BARRA SUPERIOR -->
    <div
      class="flex min-w-0 items-center justify-between gap-2"
    >

      <!-- Nombre del blog -->
      <a
        href={getRelativeLocaleUrl(locale, "")}
        class="min-w-0 truncate py-1 text-base leading-7 font-semibold sm:text-2xl"
        title={site.title}
      >
        {site.title}
      </a>

      <!-- CONTROLES SUPERIORES -->
      <div
        class="flex shrink-0 items-center gap-0.5 sm:gap-2"
      >

        <!-- Buscar -->
        {
          features.search !== false && (
            <LinkButton
              href={getRelativeLocaleUrl(locale, "search")}
              class:list={[
                "focus-outline relative flex size-9 shrink-0 items-center justify-center rounded-md sm:size-10",
                { "active-nav": isActive("/search") },
              ]}
              title={t.nav.search}
              aria-label={t.nav.search}
            >
              <IconSearch class="size-5 sm:size-6" />

              <span class="sr-only">
                {t.nav.search}
              </span>

              {isActive("/search") && (
                <IconUnderline
                  aria-hidden="true"
                  class="absolute -bottom-1 w-6 scale-125"
                />
              )}
            </LinkButton>
          )
        }

        <!-- Tema claro / oscuro -->
        {
          features.lightAndDarkMode && (
            <button
              id="theme-btn"
              type="button"
              class="focus-outline hover:[&>svg]:stroke-accent relative flex size-9 shrink-0 items-center justify-center rounded-md sm:size-10"
              title={t.a11y.toggleTheme}
              aria-label="auto"
              aria-live="polite"
            >
              <IconMoon
                class="absolute top-1/2 left-1/2 size-5 -translate-x-1/2 -translate-y-1/2 scale-100 rotate-0 transition-all dark:scale-0 dark:-rotate-90 sm:size-6"
              />
              <IconSunHigh
                class="absolute top-1/2 left-1/2 size-5 -translate-x-1/2 -translate-y-1/2 scale-0 rotate-90 transition-all dark:scale-100 dark:rotate-0 sm:size-6"
              />
            </button>
          )
        }

        <!-- Hamburguesa / Cerrar -->
        <button
          id="menu-btn"
          type="button"
          class="focus-outline relative flex size-9 shrink-0 items-center justify-center rounded-md transition-colors hover:text-accent lg:hidden"
          aria-label={t.a11y.openMenu}
          aria-expanded="false"
          aria-controls="menu-panel"
          data-label-open={t.a11y.openMenu}
          data-label-close={t.a11y.closeMenu}
        >
          <IconMenuDeep
            id="menu-icon"
            class="size-5"
          />

          <IconX
            id="close-icon"
            class="hidden size-5"
          />
        </button>
      </div>
    </div>

    <!-- NAVEGACIÓN -->
    <nav
      id="nav-menu"
      aria-label={locale === "es"
        ? "Navegación principal"
        : "Main navigation"}
      class="w-full lg:mt-3"
    >

      <!-- CONTENEDOR ANIMADO -->
      <div
        id="menu-panel"
        class="menu-panel"
      >
        <div class="menu-inner">

          <ul
            id="menu-items"
            class="grid grid-cols-1 gap-1 pt-4 lg:flex lg:flex-wrap lg:items-center lg:justify-end lg:gap-x-5 lg:gap-y-2 lg:pt-0"
          >

            <!-- Investigaciones -->
            <li>
              <a
                href={getRelativeLocaleUrl(locale, "posts")}
                class:list={[
                  "block rounded-md px-3 py-3 font-medium whitespace-nowrap hover:text-accent lg:px-2 lg:py-1",
                  { "active-nav": isActive("/posts") },
                ]}
              >
                {t.nav.posts}
              </a>
            </li>

            <!-- Etiquetas -->
            <li>
              <a
                href={getRelativeLocaleUrl(locale, "tags")}
                class:list={[
                  "block rounded-md px-3 py-3 font-medium whitespace-nowrap hover:text-accent lg:px-2 lg:py-1",
                  { "active-nav": isActive("/tags") },
                ]}
              >
                {t.nav.tags}
              </a>
            </li>

            <!-- Sobre mí -->
            <li>
              <a
                href={getRelativeLocaleUrl(locale, "about")}
                class:list={[
                  "block rounded-md px-3 py-3 font-medium whitespace-nowrap hover:text-accent lg:px-2 lg:py-1",
                  { "active-nav": isActive("/about") },
                ]}
              >
                {t.nav.about}
              </a>
            </li>

            <!-- Archivo -->
            {
              features.showArchives && (
                <li>
                  <LinkButton
                    href={getRelativeLocaleUrl(locale, "archives")}
                    class:list={[
                      "focus-outline flex min-h-11 items-center rounded-md px-3 font-medium hover:text-accent lg:relative lg:size-8 lg:min-h-0 lg:justify-center lg:p-0",
                      { "active-nav": isActive("/archives") },
                    ]}
                    title={t.nav.archives}
                    aria-label={t.nav.archives}
                  >
                    <IconArchive
                      class="hidden lg:block lg:size-6"
                    />

                    <span class="lg:sr-only">
                      {t.nav.archives}
                    </span>

                    {isActive("/archives") && (
                      <IconUnderline
                        aria-hidden="true"
                        class="absolute -bottom-1 hidden w-6 scale-125 lg:block"
                      />
                    )}
                  </LinkButton>
                </li>
              )
            }

            <!-- Selector de idioma -->
            <li
              class="border-border mt-2 flex items-center justify-between border-t px-3 pt-4 lg:mt-0 lg:border-0 lg:px-0 lg:pt-0"
            >
              <span
                class="text-muted-foreground text-sm lg:hidden"
              >
                {locale === "es" ? "Idioma" : "Language"}
              </span>

              <LanguageSwitcher />
            </li>

          </ul>

        </div>
      </div>

    </nav>
  </div>
</header>

<!-- ESTILOS DE LA ANIMACIÓN -->
<style>
  /*
   * Animación de expansión vertical.
   * Solo afecta al menú móvil y tablet.
   */

  .menu-panel {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    visibility: hidden;

    transition:
      grid-template-rows 300ms ease,
      opacity 250ms ease,
      visibility 0s linear 300ms;
  }

  .menu-inner {
    min-height: 0;
    overflow: hidden;
  }

  /* Menú abierto */
  .menu-panel.is-open {
    grid-template-rows: 1fr;
    opacity: 1;
    visibility: visible;

    transition:
      grid-template-rows 300ms ease,
      opacity 250ms ease,
      visibility 0s;
  }

  /*
   * Aparición escalonada de los enlaces.
   */
  @media (max-width: 1023px) {
    #menu-items > li {
      opacity: 0;
      transform: translateY(-8px);

      transition:
        opacity 220ms ease,
        transform 220ms ease;
    }

    .menu-panel.is-open #menu-items > li {
      opacity: 1;
      transform: translateY(0);
    }

    .menu-panel.is-open #menu-items > li:nth-child(1) {
      transition-delay: 40ms;
    }

    .menu-panel.is-open #menu-items > li:nth-child(2) {
      transition-delay: 70ms;
    }

    .menu-panel.is-open #menu-items > li:nth-child(3) {
      transition-delay: 100ms;
    }

    .menu-panel.is-open #menu-items > li:nth-child(4) {
      transition-delay: 130ms;
    }

    .menu-panel.is-open #menu-items > li:nth-child(5) {
      transition-delay: 160ms;
    }
  }

  /*
   * Escritorio:
   * navegación siempre visible.
   */
  @media (min-width: 1024px) {
    .menu-panel,
    .menu-panel.is-open {
      grid-template-rows: 1fr;
      opacity: 1;
      visibility: visible;
      transition: none;
    }

    .menu-inner {
      overflow: visible;
    }
  }

  /*
   * Accesibilidad:
   * respetar movimiento reducido.
   */
  @media (prefers-reduced-motion: reduce) {
    .menu-panel,
    .menu-panel.is-open,
    #menu-items > li {
      transition: none !important;
      transform: none !important;
    }
  }
</style>

<script>
  function toggleNav() {
    const menuBtn =
      document.querySelector<HTMLButtonElement>("#menu-btn");

    const menuPanel =
      document.querySelector<HTMLElement>("#menu-panel");

    const menuItems =
      document.querySelector<HTMLElement>("#menu-items");

    const menuIcon =
      document.querySelector("#menu-icon");

    const closeIcon =
      document.querySelector("#close-icon");

    if (
      !menuBtn ||
      !menuPanel ||
      !menuItems ||
      !menuIcon ||
      !closeIcon
    ) {
      return;
    }

    // Evitar eventos duplicados.
    if (menuBtn.dataset.initialized === "true") {
      return;
    }

    menuBtn.dataset.initialized = "true";

    const openLabel =
      menuBtn.dataset.labelOpen ?? "Open menu";

    const closeLabel =
      menuBtn.dataset.labelClose ?? "Close menu";

    const mediaQuery = window.matchMedia(
      "(min-width: 1024px)"
    );

    // Sincronizar visibilidad y accesibilidad.
    const syncAccessibility = () => {
      const isOpen =
        menuBtn.getAttribute("aria-expanded") === "true";

      menuPanel.inert =
        !mediaQuery.matches && !isOpen;
    };

    const setMenuOpen = (open: boolean) => {
      menuBtn.setAttribute(
        "aria-expanded",
        String(open)
      );

      menuBtn.setAttribute(
        "aria-label",
        open ? closeLabel : openLabel
      );

      // Activar animación CSS.
      menuPanel.classList.toggle("is-open", open);

      // Cambiar hamburguesa por X.
      menuIcon.classList.toggle("hidden", open);
      closeIcon.classList.toggle("hidden", !open);

      syncAccessibility();
    };

    // Inicializar en estado cerrado.
    setMenuOpen(false);

    // Abrir / cerrar con el botón.
    menuBtn.addEventListener("click", () => {
      const isOpen =
        menuBtn.getAttribute("aria-expanded") === "true";

      setMenuOpen(!isOpen);
    });

    // Cerrar al seleccionar un enlace.
    menuItems.addEventListener("click", event => {
      if (
        !mediaQuery.matches &&
        event.target instanceof Element &&
        event.target.closest("a")
      ) {
        setMenuOpen(false);
      }
    });

    // Adaptarse al cambio de tamaño.
    mediaQuery.addEventListener(
      "change",
      syncAccessibility
    );

    // Cerrar con Escape.
    menuBtn.addEventListener("keydown", event => {
      if (event.key === "Escape") {
        setMenuOpen(false);
      }
    });

    document.addEventListener("keydown", event => {
      if (
        event.key === "Escape" &&
        menuBtn.getAttribute("aria-expanded") === "true"
      ) {
        setMenuOpen(false);
        menuBtn.focus();
      }
    });
  }

  function handleSkipToContent() {
    const skipLink =
      document.getElementById("skip-to-content");

    if (!skipLink) return;

    if (skipLink.dataset.initialized === "true") {
      return;
    }

    skipLink.dataset.initialized = "true";

    skipLink.addEventListener("click", e => {
      if (
        e.defaultPrevented ||
        e.metaKey ||
        e.ctrlKey ||
        e.shiftKey ||
        e.button !== 0
      ) {
        return;
      }

      e.preventDefault();

      const target =
        document.getElementById("main-content");

      if (target) {
        target.setAttribute("tabindex", "-1");

        target.addEventListener(
          "blur",
          () => target.removeAttribute("tabindex"),
          { once: true }
        );

        target.focus();

        target.scrollIntoView({
          behavior: "smooth",
        });
      }
    });
  }

  toggleNav();
  handleSkipToContent();

  // Compatible con la navegación de Astro.
  document.addEventListener("astro:after-swap", () => {
    toggleNav();
    handleSkipToContent();
  });
</script>

