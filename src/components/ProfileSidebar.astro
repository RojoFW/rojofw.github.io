---
import config from "@/config";
import { useTranslations } from "@/i18n";
import IconGithub from "@/assets/icons/socials/github.svg";
import IconLinkedin from "@/assets/icons/socials/linkedin.svg";
import IconTelegram from "@/assets/icons/socials/telegram.svg";
import IconMail from "@/assets/icons/socials/mail.svg";

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale).sidebar;
const github = config.socials.find(({ name }) => name === "github");
const username = github?.url.match(/^https:\/\/github\.com\/([^/]+)\/?$/)?.[1];
const links = config.socials.map(({ name, url }) => ({
  url,
  label: ({ github: "GitHub", linkedin: "LinkedIn", telegram: "Telegram", gmail: "Email" } as Record<string, string>)[name] ?? name,
  Icon: ({ github: IconGithub, linkedin: IconLinkedin, telegram: IconTelegram, gmail: IconMail } as Record<string, typeof IconGithub>)[name],
}));
---

<aside class="profile-sidebar" aria-label={t.label} data-pagefind-ignore>
  <div class="profile-content">
    <div class="avatar-ring">
      {username ? (
        <img class="profile-avatar" src={`https://github.com/${username}.png?size=192`} alt={t.label} width="96" height="96" decoding="async" />
      ) : (
        <span class="profile-avatar profile-fallback" aria-hidden="true">R</span>
      )}
    </div>

    <div class="profile-identity">
      <p class="profile-name">RojoFW</p>
      <p class="profile-role">{t.role}</p>
      <p class="profile-summary">{t.summary}</p>
    </div>

    <p class="profile-education">{t.education}</p>

    <nav aria-label={t.socialLinks} class="profile-socials">
      {links.map(({ url, label, Icon }) => (
        <a href={url} target={url.startsWith("http") ? "_blank" : undefined} rel={url.startsWith("http") ? "noopener noreferrer" : undefined}>
          {Icon && <Icon class="social-icon" aria-hidden="true" />}
          <span>{label}</span>
        </a>
      ))}
    </nav>
  </div>
</aside>

<style>
  .profile-sidebar { display: none; }
  @media (min-width: 56rem) and (min-height: 32rem) {
    .profile-sidebar {
      position: sticky;
      top: 0;
      display: block;
      height: 100svh;
      min-width: 0;
      overflow-y: auto;
      background: transparent;
    }
    .profile-content { width: min(100%, 13.5rem); margin-inline: auto; padding: 3.25rem .75rem 1.5rem; text-align: left; }
    .avatar-ring { display: grid; place-items: center; width: 6.5rem; height: 6.5rem; padding: 3px; border-radius: 50%; background: conic-gradient(from 210deg, var(--color-accent), color-mix(in srgb, var(--color-accent) 25%, transparent), var(--color-accent)); }
    .profile-avatar { display: block; width: 100%; height: 100%; border: 3px solid var(--color-background); border-radius: 50%; object-fit: cover; background: var(--color-background); }
    .profile-fallback { display: grid; place-items: center; color: var(--color-accent); font-size: 2.25rem; font-weight: 700; }
    .profile-identity { margin-top: 1.45rem; }
    .profile-name { font-size: 1.25rem; font-weight: 700; line-height: 1.3; }
    .profile-role { margin-top: .55rem; color: var(--color-foreground); font-size: .88rem; line-height: 1.55; }
    .profile-summary { margin-top: .8rem; color: var(--color-muted-foreground); font-size: .79rem; line-height: 1.65; }
    .profile-education { margin-top: 1.55rem; color: var(--color-accent); font-size: .82rem; line-height: 1.65; }
    .profile-socials { display: grid; gap: .85rem; width: max-content; max-width: 100%; margin-top: 2rem; font-size: .88rem; }
    .profile-socials a { display: flex; align-items: center; gap: .7rem; width: fit-content; color: var(--color-muted-foreground); text-decoration: none; }
    .profile-socials a:hover { color: var(--color-accent); }
    .profile-socials :global(.social-icon) { width: 1.1rem; height: 1.1rem; flex: none; }
  }
</style>
