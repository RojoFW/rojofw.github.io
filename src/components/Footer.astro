
---
import type { HTMLAttributes } from "astro/types";

import IconRss from "@/assets/icons/IconRss.svg";

import { getAssetPath } from "@/utils/withBase";
import { useTranslations } from "@/i18n";
import config from "@/config";

type Props = {
  noMarginTop?: boolean;
} & HTMLAttributes<"footer">;

const { noMarginTop = false, class: className, ...attrs } = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const currentYear = new Date().getFullYear();
const rssHref = getAssetPath("rss.xml");
---

<footer
  class:list={[
    "app-layout",
    { "mt-auto": !noMarginTop },
    className,
  ]}
  {...attrs}
>
  <div
    class="border-border flex flex-col items-center justify-between gap-4 border-t py-6 sm:flex-row sm:py-5"
  >
    <!-- IDENTIDAD Y COPYRIGHT -->
    <p class="text-muted-foreground text-xs leading-relaxed">
      {t.footer.copyright} &#169; {currentYear}
      <span class="mx-1">·</span>
      {t.footer.allRightsReserved}
    </p>

    <!-- RSS -->
    <div
      class="flex flex-wrap items-center justify-center gap-4 sm:justify-end"
    >
      <!-- RSS -->
      <a
        href={rssHref}
        target="_blank"
        rel="noopener noreferrer"
        class="focus-outline text-foreground hover:text-accent inline-flex items-center justify-center transition-colors duration-200"
        aria-label={t.a11y.rssFeed}
        title={t.a11y.rssFeed}
      >
        <IconRss
          width={21}
          height={21}
          aria-hidden="true"
        />

        <span class="sr-only">
          {t.a11y.rssFeed}
        </span>
      </a>
    </div>
  </div>
</footer>

