
---
import { getRelativeLocaleUrl } from "astro:i18n";

import IconMenuDeep from "@/assets/icons/IconMenuDeep.svg";
import IconArchive from "@/assets/icons/IconArchive.svg";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import IconSearch from "@/assets/icons/IconSearch.svg";
import IconMoon from "@/assets/icons/IconMoon.svg";
import IconX from "@/assets/icons/IconX.svg";

import LinkButton from "./LinkButton.astro";
import LanguageSwitcher from "./LanguageSwitcher.astro";

import { stripBase, stripLocale } from "@/utils/withBase";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { site, features } = config;

const locale = Astro.currentLocale ?? site.lang;
const t = useTranslations(locale);

// Normalizar la ruta actual.
const relativePath = stripBase(Astro.url.pathname);

const pathWithoutTrailingSlash =
  relativePath.endsWith("/") && relativePath !== "/"
    ? relativePath.slice(0, -1)
    : relativePath;

const currentPath = stripLocale(
  pathWithoutTrailingSlash,
  locale
);

// Determinar el enlace activo.
const isActive = (path: string) => {
  const current = currentPath.split("/").filter(Boolean);
  const expected = path.split("/").filter(Boolean);

  return (
    currentPath === path ||
    (expected.length > 0 && current[0] === expected[0])
  );
};
---

<!-- ACCESIBILIDAD -->
<a
  id="skip-to-content"
  href="#main-content"
  class="bg-background text-accent absolute inset-s-16 -top-full z-50 px-3 py-2 backdrop-blur-lg transition-all focus:top-4"
>
  {t.a11y.skipToContent}
</a>

<!-- HEADER -->
<header class="app-layout">
  <div
    class="border-border grid grid-cols-[minmax(0,1fr)_auto] items-center border-b py-3 sm:py-5"
  >

    <!-- ================================= -->
    <!-- NOMBRE DEL BLOG -->
    <!-- ================================= -->

    <a
      href={getRelativeLocaleUrl(locale, "")}
      class="col-start-1 row-start-1 min-w-0 truncate py-1 text-base leading-7 font-semibold sm:text-2xl lg:col-span-2"
      title={site.title}
    >
      {site.title}
    </a>

    <!-- ================================= -->
    <!-- CONTROLES DE LA DERECHA -->
    <!-- ================================= -->

    <div
      class="col-start-2 row-start-1 flex shrink-0 items-center justify-end gap-0.5 sm:gap-2 lg:row-start-2"
    >

      <!-- BUSCADOR -->
      {
        features.search !== false && (
          <LinkButton
            href={getRelativeLocaleUrl(locale, "search")}
            class:list={[
              "focus-outline tech-icon-link no-underline hover:no-underline relative flex size-9 shrink-0 items-center justify-center rounded-md transition-colors duration-200 hover:text-accent sm:size-10 lg:size-9",
              { "tech-nav-active": isActive("/search") },
            ]}
            title={t.nav.search}
            aria-label={t.nav.search}
            aria-current={isActive("/search") ? "location" : undefined}
          >
            <IconSearch class="size-5 sm:size-6" />

            <span class="sr-only">
              {t.nav.search}
            </span>
          </LinkButton>
        )
      }

      <!-- SELECTOR DE TEMA -->
      {
        features.lightAndDarkMode && (
          <button
            id="theme-btn"
            type="button"
            class="focus-outline hover:[&>svg]:stroke-accent relative flex size-9 shrink-0 items-center justify-center rounded-md sm:size-10 lg:size-9"
            title={t.a11y.toggleTheme}
            aria-label="auto"
            aria-live="polite"
          >
            <IconMoon
              class="absolute top-1/2 left-1/2 size-5 -translate-x-1/2 -translate-y-1/2 scale-100 rotate-0 transition-all dark:scale-0 dark:-rotate-90 sm:size-6"
            />

            <IconSunHigh
              class="absolute top-1/2 left-1/2 size-5 -translate-x-1/2 -translate-y-1/2 scale-0 rotate-90 transition-all dark:scale-100 dark:rotate-0 sm:size-6"
            />
          </button>
        )
      }

      <!-- SELECTOR DE IDIOMA: ESCRITORIO -->
      <div class="hidden lg:flex lg:items-center">
        <LanguageSwitcher />
      </div>

      <!-- HAMBURGUESA / X: MÓVIL -->
      <button
        id="menu-btn"
        type="button"
        class="focus-outline relative flex size-9 shrink-0 items-center justify-center rounded-md transition-colors hover:text-accent lg:hidden"
        aria-label={t.a11y.openMenu}
        aria-expanded="false"
        aria-controls="menu-panel"
        data-label-open={t.a11y.openMenu}
        data-label-close={t.a11y.closeMenu}
      >
        <IconMenuDeep
          id="menu-icon"
          class="size-5"
        />

        <IconX
          id="close-icon"
          class="hidden size-5"
        />
      </button>
    </div>

    <!-- ================================= -->
    <!-- NAVEGACIÓN IZQUIERDA -->
    <!-- ================================= -->

    <nav
      id="nav-menu"
      aria-label={locale === "es"
        ? "Navegación principal"
        : "Main navigation"}
      class="col-span-2 col-start-1 row-start-2 min-w-0 w-full lg:col-span-1 lg:mt-3"
    >

      <!-- CONTENEDOR ANIMADO -->
      <div
        id="menu-panel"
        class="menu-panel"
      >
        <div class="menu-inner">

          <ul
            id="menu-items"
            class="grid grid-cols-1 gap-1 pt-4 lg:flex lg:flex-wrap lg:items-center lg:justify-start lg:gap-x-3 lg:gap-y-2 lg:pt-0"
          >

            <!-- INVESTIGACIONES -->
            <li>
              <a
                href={getRelativeLocaleUrl(locale, "posts")}
                class:list={[
                  "tech-nav-link relative block no-underline hover:no-underline rounded-md px-3 py-3 font-medium whitespace-nowrap transition-colors duration-200 hover:text-accent lg:px-2 lg:py-1",
                  { "tech-nav-active": isActive("/posts") },
                ]}
                aria-current={isActive("/posts") ? "location" : undefined}
              >
                <span class="tech-nav-label">{t.nav.posts}</span>
              </a>
            </li>

            <!-- ETIQUETAS -->
            <li>
              <a
                href={getRelativeLocaleUrl(locale, "tags")}
                class:list={[
                  "tech-nav-link relative block no-underline hover:no-underline rounded-md px-3 py-3 font-medium whitespace-nowrap transition-colors duration-200 hover:text-accent lg:px-2 lg:py-1",
                  { "tech-nav-active": isActive("/tags") },
                ]}
                aria-current={isActive("/tags") ? "location" : undefined}
              >
                <span class="tech-nav-label">{t.nav.tags}</span>
              </a>
            </li>

            <!-- CONTACTO -->
            <li>
              <a
                href={getRelativeLocaleUrl(locale, "contact")}
                class:list={[
                  "tech-nav-link relative block no-underline hover:no-underline rounded-md px-3 py-3 font-medium whitespace-nowrap transition-colors duration-200 hover:text-accent lg:px-2 lg:py-1",
                  { "tech-nav-active": isActive("/contact") },
                ]}
                aria-current={isActive("/contact") ? "location" : undefined}
              >
                <span class="tech-nav-label">{t.nav.contact}</span>
              </a>
            </li>

            <!-- ARCHIVO -->
            {
              features.showArchives && (
                <li>
                  <LinkButton
                    href={getRelativeLocaleUrl(locale, "archives")}
                    class:list={[
                      "focus-outline tech-nav-link tech-nav-icon-link no-underline hover:no-underline flex min-h-11 items-center rounded-md px-3 font-medium transition-colors duration-200 hover:text-accent lg:relative lg:size-8 lg:min-h-0 lg:justify-center lg:p-0",
                      { "tech-nav-active": isActive("/archives") },
                    ]}
                    title={t.nav.archives}
                    aria-label={t.nav.archives}
                    aria-current={isActive("/archives") ? "location" : undefined}
                  >

                    <IconArchive
                      class="hidden lg:block lg:size-6"
                    />

                    <span class="tech-nav-label lg:sr-only">
                      {t.nav.archives}
                    </span>
                  </LinkButton>
                </li>
              )
            }

            <!-- IDIOMA: SOLO MENÚ MÓVIL -->
            <li
              class="border-border mt-2 flex items-center justify-between border-t px-3 pt-4 lg:hidden"
            >
              <span class="text-muted-foreground text-sm">
                {locale === "es" ? "Idioma" : "Language"}
              </span>

              <LanguageSwitcher />
            </li>

          </ul>
        </div>
      </div>
    </nav>
  </div>
</header>

<!-- ================================= -->
<!-- ANIMACIONES -->
<!-- ================================= -->

<style>
  /* Los enlaces principales nunca usan el subrayado ondulado heredado. */
  :global(#nav-menu .tech-nav-link),
  :global(#nav-menu .tech-nav-link:hover),
  :global(#nav-menu .tech-nav-link:focus-visible) {
    text-decoration: none !important;
  }

  /* El indicador queda exactamente bajo el texto (sin incluir padding). */
  :global(#nav-menu .tech-nav-label) {
    position: relative;
    display: inline-block;
  }

  :global(#nav-menu .tech-nav-label)::after {
    content: "";
    position: absolute;
    inset-inline: 0;
    bottom: -0.34rem;
    height: 2px;
    background-color: var(--accent);
    border-radius: 2px;
    transform: scaleX(0);
    transform-origin: left center;
    opacity: 0;
    transition: transform 210ms ease, opacity 210ms ease;
  }

  /* El indicador permanece visible en la sección activa. */
  :global(#nav-menu a.tech-nav-link:hover .tech-nav-label)::after,
  :global(#nav-menu a.tech-nav-link:focus-visible .tech-nav-label)::after,
  :global(#nav-menu a.tech-nav-active .tech-nav-label)::after {
    transform: scaleX(1);
    opacity: 1;
  }

  /* La página activa se identifica por el color, sin una barra permanente. */
  :global(#nav-menu a.tech-nav-active),
  :global(header a.tech-icon-link.tech-nav-active) {
    color: var(--accent);
  }

  /* Indicador compartido por los enlaces que se muestran como iconos. */
  :global(header a.tech-icon-link)::after,
  :global(#nav-menu a.tech-nav-icon-link)::after {
    content: "";
    position: absolute;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    bottom: 1px;
    left: calc(50% - 2px);
    background: var(--accent);
    opacity: 0;
    transform: scale(0);
    transition: opacity 210ms ease, transform 210ms ease;
  }

  :global(header a.tech-icon-link:hover)::after,
  :global(header a.tech-icon-link:focus-visible)::after,
  :global(header a.tech-icon-link.tech-nav-active)::after {
    opacity: 1;
    transform: scale(1);
  }

  @media (min-width: 1024px) {
    :global(#nav-menu a.tech-nav-icon-link:hover)::after,
    :global(#nav-menu a.tech-nav-icon-link:focus-visible)::after,
    :global(#nav-menu a.tech-nav-icon-link.tech-nav-active)::after {
      opacity: 1;
      transform: scale(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(#nav-menu .tech-nav-label)::after,
    :global(header a.tech-icon-link)::after,
    :global(#nav-menu a.tech-nav-icon-link)::after {
      transition: none;
    }
  }

  .menu-panel {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    visibility: hidden;

    transition:
      grid-template-rows 300ms ease,
      opacity 250ms ease,
      visibility 0s linear 300ms;
  }

  .menu-inner {
    min-height: 0;
    overflow: hidden;
  }

  /* Menú abierto */
  .menu-panel.is-open {
    grid-template-rows: 1fr;
    opacity: 1;
    visibility: visible;

    transition:
      grid-template-rows 300ms ease,
      opacity 250ms ease,
      visibility 0s;
  }

  /* Animación individual de los enlaces */
  @media (max-width: 1023px) {
    #menu-items > li {
      opacity: 0;
      transform: translateY(-8px);

      transition:
        opacity 220ms ease,
        transform 220ms ease;
    }

    .menu-panel.is-open #menu-items > li {
      opacity: 1;
      transform: translateY(0);
    }

    .menu-panel.is-open #menu-items > li:nth-child(1) {
      transition-delay: 40ms;
    }

    .menu-panel.is-open #menu-items > li:nth-child(2) {
      transition-delay: 70ms;
    }

    .menu-panel.is-open #menu-items > li:nth-child(3) {
      transition-delay: 100ms;
    }

    .menu-panel.is-open #menu-items > li:nth-child(4) {
      transition-delay: 130ms;
    }

    .menu-panel.is-open #menu-items > li:nth-child(5) {
      transition-delay: 160ms;
    }
  }

  /* Escritorio: navegación siempre visible */
  @media (min-width: 1024px) {
    .menu-panel,
    .menu-panel.is-open {
      grid-template-rows: 1fr;
      opacity: 1;
      visibility: visible;
      transition: none;
    }

    .menu-inner {
      overflow: visible;
    }
  }

  /* Accesibilidad */
  @media (prefers-reduced-motion: reduce) {
    .menu-panel,
    .menu-panel.is-open,
    #menu-items > li {
      transition: none !important;
      transform: none !important;
    }
  }
</style>

<!-- ================================= -->
<!-- JAVASCRIPT -->
<!-- ================================= -->

<script>
  function toggleNav() {
    const menuBtn =
      document.querySelector<HTMLButtonElement>("#menu-btn");

    const menuPanel =
      document.querySelector<HTMLElement>("#menu-panel");

    const menuItems =
      document.querySelector<HTMLElement>("#menu-items");

    const menuIcon =
      document.querySelector("#menu-icon");

    const closeIcon =
      document.querySelector("#close-icon");

    if (
      !menuBtn ||
      !menuPanel ||
      !menuItems ||
      !menuIcon ||
      !closeIcon
    ) {
      return;
    }

    // Evitar inicialización duplicada.
    if (menuBtn.dataset.initialized === "true") {
      return;
    }

    menuBtn.dataset.initialized = "true";

    const openLabel =
      menuBtn.dataset.labelOpen ?? "Open menu";

    const closeLabel =
      menuBtn.dataset.labelClose ?? "Close menu";

    const mediaQuery = window.matchMedia(
      "(min-width: 1024px)"
    );

    // Accesibilidad del menú cerrado.
    const syncAccessibility = () => {
      const isOpen =
        menuBtn.getAttribute("aria-expanded") === "true";

      menuPanel.inert =
        !mediaQuery.matches && !isOpen;
    };

    // Abrir o cerrar menú.
    const setMenuOpen = (open: boolean) => {
      menuBtn.setAttribute(
        "aria-expanded",
        String(open)
      );

      menuBtn.setAttribute(
        "aria-label",
        open ? closeLabel : openLabel
      );

      // Activar animación CSS.
      menuPanel.classList.toggle("is-open", open);

      // Alternar iconos.
      menuIcon.classList.toggle("hidden", open);
      closeIcon.classList.toggle("hidden", !open);

      // Actualizar accesibilidad.
      syncAccessibility();
    };

    // Estado inicial.
    setMenuOpen(false);

    // Evento del botón.
    menuBtn.addEventListener("click", () => {
      const isOpen =
        menuBtn.getAttribute("aria-expanded") === "true";

      setMenuOpen(!isOpen);
    });

    // Cerrar al seleccionar un enlace.
    menuItems.addEventListener("click", event => {
      if (
        !mediaQuery.matches &&
        event.target instanceof Element &&
        event.target.closest("a")
      ) {
        setMenuOpen(false);
      }
    });

    // Sincronizar al cambiar de resolución.
    mediaQuery.addEventListener(
      "change",
      syncAccessibility
    );

    // Cerrar mediante Escape.
    menuBtn.addEventListener("keydown", event => {
      if (event.key === "Escape") {
        setMenuOpen(false);
      }
    });

    document.addEventListener("keydown", event => {
      if (
        event.key === "Escape" &&
        menuBtn.getAttribute("aria-expanded") === "true"
      ) {
        setMenuOpen(false);
        menuBtn.focus();
      }
    });
  }

  function handleSkipToContent() {
    const skipLink =
      document.getElementById("skip-to-content");

    if (!skipLink) return;

    if (skipLink.dataset.initialized === "true") {
      return;
    }

    skipLink.dataset.initialized = "true";

    skipLink.addEventListener("click", e => {
      if (
        e.defaultPrevented ||
        e.metaKey ||
        e.ctrlKey ||
        e.shiftKey ||
        e.button !== 0
      ) {
        return;
      }

      e.preventDefault();

      const target =
        document.getElementById("main-content");

      if (target) {
        target.setAttribute("tabindex", "-1");

        target.addEventListener(
          "blur",
          () => target.removeAttribute("tabindex"),
          { once: true }
        );

        target.focus();

        target.scrollIntoView({
          behavior: "smooth",
        });
      }
    });
  }

  toggleNav();
  handleSkipToContent();

  // Navegación Astro View Transitions.
  document.addEventListener("astro:after-swap", () => {
    toggleNav();
    handleSkipToContent();
  });
</script>
