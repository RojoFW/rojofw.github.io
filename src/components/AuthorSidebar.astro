---
import { getRelativeLocaleUrl } from "astro:i18n";
import config from "@/config";

type Props = { postCount: number };
const { postCount } = Astro.props;
const locale = Astro.currentLocale ?? config.site.lang;
const isSpanish = locale === "es";
const github = config.socials.find(link => link.name === "github");
const avatar = github?.url.match(/^https:\/\/github\.com\/([^/]+)\/?$/)?.[1];
const specialties = isSpanish
  ? [
      "Seguridad ofensiva",
      "Análisis de vulnerabilidades",
      "Herramientas de seguridad",
    ]
  : ["Offensive security", "Vulnerability analysis", "Security tooling"];
---

<aside
  class="author-sidebar"
  aria-label={isSpanish ? "Perfil del autor" : "Author profile"}
  data-pagefind-ignore
>
  <div class="author-heading">
    {
      avatar ? (
        <img
          class="author-avatar"
          src={`https://github.com/${avatar}.png?size=160`}
          alt={
            isSpanish
              ? `Avatar de ${config.site.author}`
              : `${config.site.author}'s avatar`
          }
          width="80"
          height="80"
          loading="lazy"
          decoding="async"
        />
      ) : (
        <span class="author-avatar author-initial" aria-hidden="true">
          {config.site.author.charAt(0)}
        </span>
      )
    }
    <div>
      <p class="author-name">{config.site.author}</p>
      <p class="author-role">
        {
          isSpanish
            ? "Investigador de ciberseguridad"
            : "Cybersecurity researcher"
        }
      </p>
    </div>
  </div>

  <div class="author-details">
    <div class="author-section">
      <h2>{isSpanish ? "Trayectoria en el blog" : "On the blog"}</h2>
      <p>
        <strong>{postCount}</strong>
        {
          isSpanish
            ? postCount === 1
              ? "investigación publicada"
              : "investigaciones publicadas"
            : postCount === 1
              ? "published article"
              : "published articles"
        }
      </p>
    </div>
    <div class="author-section">
      <h2>{isSpanish ? "Áreas de trabajo" : "Areas of work"}</h2>
      <ul>{specialties.map(item => <li>{item}</li>)}</ul>
    </div>
    <nav
      class="author-section"
      aria-label={isSpanish ? "Enlaces del autor" : "Author links"}
    >
      <h2>{isSpanish ? "Conecta" : "Connect"}</h2>
      <ul>
        {
          config.socials.map(({ name, url }) => (
            <li>
              <a
                href={url}
                target={url.startsWith("http") ? "_blank" : undefined}
                rel={url.startsWith("http") ? "noopener noreferrer" : undefined}
              >
                {name === "gmail"
                  ? "Email"
                  : name.charAt(0).toUpperCase() + name.slice(1)}
              </a>
            </li>
          ))
        }
        <li>
          <a href={getRelativeLocaleUrl(locale, "about")}
            >{isSpanish ? "Sobre mí" : "About me"}</a>
        </li>
      </ul>
    </nav>
  </div>
</aside>

<style>
  .author-sidebar {
    min-width: 0;
    padding: 1.25rem;
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    background: var(--color-muted);
  }
  .author-heading {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .author-avatar {
    width: 5rem;
    height: 5rem;
    flex: none;
    border: 2px solid var(--color-border);
    border-radius: 50%;
    object-fit: cover;
  }
  .author-initial {
    display: grid;
    place-items: center;
    background: var(--color-background);
    color: var(--color-accent);
    font-size: 2rem;
    font-weight: 700;
  }
  .author-name {
    font-weight: 700;
    line-height: 1.3;
  }
  .author-role {
    margin-top: 0.25rem;
    color: var(--color-muted-foreground);
    font-size: 0.8rem;
    line-height: 1.5;
  }
  .author-details {
    display: grid;
    gap: 1.25rem;
    margin-top: 1.5rem;
  }
  .author-section h2 {
    margin-bottom: 0.5rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .author-section p,
  .author-section li {
    color: var(--color-muted-foreground);
    font-size: 0.85rem;
    line-height: 1.65;
  }
  .author-section strong {
    color: var(--color-accent);
    font-size: 1.1rem;
  }
  .author-section ul {
    display: grid;
    gap: 0.25rem;
  }
  .author-section a {
    color: var(--color-foreground);
    text-decoration: underline;
    text-decoration-color: var(--color-border);
    text-underline-offset: 0.2em;
  }
  .author-section a:hover {
    color: var(--color-accent);
  }
  @media (min-width: 64rem) {
    .author-sidebar {
      position: sticky;
      top: 2rem;
      align-self: start;
      padding: 1rem;
    }
    .author-heading {
      display: block;
    }
    .author-heading > div {
      margin-top: 0.9rem;
    }
  }
</style>
